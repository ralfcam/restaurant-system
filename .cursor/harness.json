{
  "schemaVersion": 1,
  "harnessVersion": "0.3.1",
  "initialized": true,
  "project": {
    "name": "restaurant-system",
    "repository": "https://github.com/ralfcam/restaurant-system"
  },
  "template": {
    "repository": "https://github.com/vercel/next.js",
    "ref": "v16.3.5",
    "example": "examples/with-supabase",
    "generator": "create-next-app@16.3.5"
  },
  "runtime": {
    "nodeMinimum": "22.22.0",
    "pnpmVersion": "10.34.5"
  },
  "packageManager": "pnpm",
  "commands": {
    "lint": "pnpm lint",
    "typecheck": "pnpm typecheck",
    "unit": "pnpm test:unit",
    "integration": "pnpm test:integration",
    "e2e": "pnpm test:e2e",
    "build": "pnpm build",
    "harness": "pnpm test:harness"
  },
  "git": {
    "defaultBranch": "main",
    "accumulatorBranch": "staging",
    "prBase": "staging",
    "featurePrefix": "sdd/",
    "cloudHeadPattern": "cursor/<slug>-<4 hex>"
  },
  "linear": {
    "teamKey": "RES",
    "issuePrefix": "RES",
    "routingMode": "versionKey",
    "versionKeyPattern": "V-X.X",
    "namedProjects": [],
    "conductorAllowlist": [],
    "excludedMilestones": [],
    "excludedLabels": [],
    "statusWrites": "comment-only"
  },
  "supabase": {
    "guardedProjectRefs": [],
    "migrations": "validate-only",
    "localReset": true
  },
  "conductor": {
    "file": ".cursor/conductor.json",
    "enabled": true,
    "morningMode": "activate"
  },
  "p0Surfaces": [],
  "coderabbit": {
    "enabled": true,
    "teamKey": "US",
    "baseBranches": [
      "staging"
    ],
    "drafts": true,
    "pauseAfterReviewedCommits": 20,
    "requestChangesWorkflow": true,
    "missingReview": "ready_no_coderabbit_review",
    "specRoot": "docs/specs"
  },
  "prAuthoring": {
    "mode": "service-account-automation",
    "botLogin": "cursor[bot]"
  },
  "docs": {
    "root": "docs",
    "okfVersion": "0.2",
    "specsRoot": "docs/specs",
    "runbooksRoot": "docs/runbooks",
    "findingsRoot": "docs/findings"
  },
  "dispatch": {
    "minimumActive": 5,
    "maximumActive": 10
  },
  "integrations": {
    "linear": {
      "enabled": true
    },
    "coderabbit": {
      "enabled": true
    }
  }
}
